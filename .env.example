APP_NAME="TrustCart AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=trustcart
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# The model parses requirements and writes explanations. It never decides a
# constraint and never touches an amount.
#
# Supported: gemini, deepseek. Set the primary provider and an optional
# fallback. With no key, the deterministic parser runs and the record states it.
TRUSTCART_AI_PROVIDER=gemini
TRUSTCART_AI_FALLBACK=deepseek
TRUSTCART_AI_TIMEOUT=25

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------------------------------------------------------------------
# PayPal — sandbox only
# ---------------------------------------------------------------------------
# Create an app at https://developer.paypal.com/dashboard/applications/sandbox
# Copy its Client ID and Secret here. Never commit them. Live credentials are
# refused by the checkout service unless allow_live is explicitly enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
PAYPAL_WEBHOOK_ID=
PAYPAL_TIMEOUT=25

# ---------------------------------------------------------------------------
# Demo behaviour
# ---------------------------------------------------------------------------
TRUSTCART_DEMO_MODE=true
TRUSTCART_APPROVAL_TTL=15
